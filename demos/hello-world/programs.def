MC_PROGRAM(blobsh, "blob.vert", "blob.frag")
MC_PROGRAM(space, "sky.vert", "space.frag")
MC_PROGRAM(planet_sh, "planet.vert", "planet.frag")
MC_PROGRAM(atmo, "planet.vert", "atmo.frag")
MC_PROGRAM(moon_sh, "planet.vert", "moon.frag")
MC_PROGRAM(ocean_sh, "ocean.vert", "ocean.frag")
MC_PROGRAM(water, "far.vert", "water.frag")
MC_PROGRAM(dip, "sky.vert", "dip.frag")
MC_PROGRAM(uwsurf, "object.vert", "uwsurf.frag")
MC_PROGRAM(uwrock, "rock.vert", "uwsurf.frag")
MC_PROGRAM(fishsh, "fish.vert", "fish.frag")
MC_PROGRAM(algaesh, "algae.vert", "algae.frag")
MC_PROGRAM(whalesh, "fish.vert", "whale.frag")
MC_PROGRAM(coralsh, "coral.vert", "coral.frag")
